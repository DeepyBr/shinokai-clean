{
  "expo": {
    "name": "Shinokai",
    "slug": "shinokai-clean",
    "version": "1.0.25",
    "orientation": "default",
    "icon": "./assets/images/splash-icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "shinokai",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0E12"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shinokai.clean"
    },
    "android": {
      "package": "com.shinokai.clean",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/splash-icon.png",
        "backgroundColor": "#0A0E12"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.FOREGROUND_SERVICE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Precisamos da câmera para ler o QR Code e conectar sua TV."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/splash-icon.png",
          "color": "#E21221"
        }
      ]
    ]
  }
}
